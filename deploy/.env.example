# Copiar a deploy/.env (no versionado) y completar. `docker compose` lo lee automáticamente
# porque vive junto a docker-compose.yml. Sin valores secretos reales acá.

# --- Variables de compose (Postgres, puertos publicados) ---
POSTGRES_USER=predicts
POSTGRES_PASSWORD=predicts
POSTGRES_DB=predicts
POSTGRES_PORT=54320
API_PORT=8000
WEB_PORT=8080

# --- Claves de api/src/predicts/config.py (Settings) ---
ENTORNO=dev
# Obligatoria si ENTORNO != dev.
SECRET_KEY=

# Si se deja vacía, docker-compose la arma con POSTGRES_* de arriba contra el servicio `postgres`.
DATABASE_URL=
# Solo para tests (api/tests/conftest_db.py): URL "admin" donde el usuario pueda crear/borrar
# bases. En desarrollo normal, el Postgres del homelab: ver docs/notas/desarrollo.md.
TEST_DATABASE_URL=

DATA_DIR=/data

ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=
ROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Si falta SMTP_HOST, el email se escribe en el log en vez de enviarse. SMTP_PORT es int
# obligatorio en Settings: si se deja vacío, docker-compose usa 587 (no se usa de todos modos
# mientras SMTP_HOST esté vacío).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

MAX_CSV_MB=500
MIN_COMPRAS=3
HORIZONTE_DIAS=7
VENTANA_VALIDACION_SEMANAS=4
CONFIANZA_MAPEO=0.8
CONFIANZA_JEV=0.7
RETENCION_DIAS=7

DUCKDB_MEMORY_LIMIT=3GB
DUCKDB_THREADS=4
MAX_MEMORIA_TRABAJO_MB=4096
TIMEOUT_TRABAJO_S=1800

# Orígenes CORS de la API (no es parte de Settings, lo lee predicts/app.py directo). Con el
# proxy de nginx en deploy/nginx.conf el front llama a /api/... del mismo origen, así que
# normalmente no hace falta tocar esto.
CORS_ORIGENES=http://localhost:8080
