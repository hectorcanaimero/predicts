# Variables extra para el override de producción (deploy/vps/docker-compose.prod.yml), además
# de las de deploy/.env.example. docker compose solo lee deploy/.env (el directorio del primer
# archivo pasado con -f) aunque el override esté en deploy/vps/ — por eso estas líneas van
# pegadas a deploy/.env, no a un .env separado en esta carpeta. Ver docs/notas/despliegue.md.

# Dominio público que resuelve a este VPS (Caddy pide el certificado TLS solo para ese nombre).
# "localhost" para el ensayo local: Caddy usa su certificado interno en vez de pedirle uno a
# Let's Encrypt.
DOMINIO=localhost

# Sin valor real acá: ENTORNO=prod exige SECRET_KEY (ver api/src/predicts/config.py). Generarla
# con, por ejemplo, `openssl rand -hex 32`.
SECRET_KEY=

# Obligatorias en producción (el override las exige): sin SMTP real, los emails de recuperación
# de contraseña no salen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Retención de los backups diarios de Postgres en el volumen postgres_backups (deploy/vps/backup.sh).
RETENCION_BACKUPS_DIAS=7

# Atar estos puertos a localhost en el VPS: ya no hace falta publicarlos a toda la red porque
# Caddy es el único punto de entrada público (80/443, ver instalar.sh). docker compose acepta
# "ip:puerto_host" en estas variables.
API_PORT=127.0.0.1:8000
WEB_PORT=127.0.0.1:8080
POSTGRES_PORT=127.0.0.1:54320
